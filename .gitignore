# Secrets and demo credentials: never commit
.streamlit/secrets.toml
demo_accounts.local.toml
*.local.toml
.env
.env.*

# Raw downloads (the combined data/resale.parquet is committed instead)
data/raw/

# Answer feedback votes written by the running app (runway/bridge.py)
data/feedback.jsonl

# Reviewer uploads and edits on the running app's own disk (committed copies go to data/corpus and data/content.json)
data/runtime/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store

# Local Claude Code files (worktrees, preview settings); the shared project settings are committed
.claude/*
!.claude/settings.json
