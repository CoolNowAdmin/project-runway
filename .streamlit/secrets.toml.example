# Copy to .streamlit/secrets.toml (gitignored) or paste into Streamlit Cloud > App settings > Secrets.
# Generate the [auth.users] block with:  python scripts/seed_users.py
ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-haiku-5-5"  # default is claude-opus-5-5; Haiku costs far less per answer
# Lasting storage for reviewer edits, uploaded Ask documents and answer votes (runway/store.py):
# DATABASE_URL = "postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# R2_ACCOUNT_ID = "..."          # Cloudflare R2 keeps the original uploaded files
# R2_ACCESS_KEY_ID = "..."
# R2_SECRET_ACCESS_KEY = "..."
# R2_BUCKET = "runway-uploads"
# Without DATABASE_URL, a GitHub token keeps edits instead:
# GITHUB_TOKEN = "github_pat_..."  # keeps reviewer uploads and page edits: fine-grained, this repo only, Contents read/write

[auth.users]
# username = "pbkdf2_sha256$310000$<salt>$<hash>"   (written by the seed script; never put plain passwords here)
